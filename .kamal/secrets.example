# Copy to .kamal/secrets (gitignored) and fill in real values.
# Also create .kamal/host (gitignored) containing the deploy target,
# e.g. root@my-server.example.com

# GitHub personal access token with write:packages (for ghcr.io)
KAMAL_REGISTRY_PASSWORD=ghp_...

# mix phx.gen.secret
SECRET_KEY_BASE=...

# Postgres accessory credentials. DATABASE_URL points at the accessory
# container (<service>-db on the kamal docker network).
POSTGRES_PASSWORD=...
DATABASE_URL=ecto://ppr_api:${POSTGRES_PASSWORD}@ppr_api-db:5432/ppr_api_production

# Cloudflare R2 (S3-compatible) storage for CSV backups
R2_BUCKET=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_ENDPOINT=<account-id>.r2.cloudflarestorage.com

# AppSignal
APPSIGNAL_PUSH_API_KEY=...
